{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crawde",
  "version": "0.1.16",
  "identifier": "com.joezhuo.crawde",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "pet", "title": "Crawde", "width": 350, "height": 520,
      "transparent": true, "decorations": false, "shadow": false,
      "alwaysOnTop": true, "skipTaskbar": true, "resizable": false,
      "visible": false, "focus": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; media-src 'self' blob:"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/icon.png"] }
}
